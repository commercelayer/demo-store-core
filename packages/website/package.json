{
  "name": "@commercelayer/demo-store-website",
  "version": "6.0.0",
  "description": "This Demo Store is a completely static ecommerce solution (with SSR capability) powered by Commerce Layer.",
  "private": true,
  "scripts": {
    "sync:organization": "dotenv -c local node npm-sync-organization.js",
    "build": "next build --webpack",
    "postbuild": "next-sitemap",
    "start": "next start",
    "dev": "next dev --webpack",
    "local:build": "dotenv -c local npm run build",
    "local:start": "npm start",
    "local:serve": "npx serve out",
    "lint": "eslint ./src/ --fix",
    "ts:check": "tsc --noEmit && npm run test:data",
    "test:data": "node data/runTestData.js",
    "test": "jest --testPathIgnorePatterns ./data",
    "coverage": "jest --coverage",
    "lighthouse": "npx -p @lhci/cli lhci autorun"
  },
  "dependencies": {
    "@commercelayer/demo-store-types": "^6.0.0",
    "@commercelayer/js-auth": "^8.0.1",
    "@commercelayer/react-components": "4.28.8",
    "@commercelayer/sdk": "6.52.0",
    "@svgr/webpack": "^8.1.0",
    "@types/lodash": "^4.17.25",
    "fuse.js": "^7.5.0",
    "immer": "^11.1.21",
    "lodash": "^4.18.1",
    "next": "^16.3.8",
    "next-localization": "^0.12.0",
    "react": "^19",
    "react-dom": "^19",
    "react-remark": "^2.1.0",
    "swiper": "^12.2.0",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 22.13"
  }
}
